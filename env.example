# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real secrets.

# Free tier key from https://www.football-data.org/client/register
# (Register → confirm email → the key is emailed to you / shown in your account.)
FOOTBALL_DATA_API_KEY=

# Comma-separated list of origins allowed to call this proxy. Set this to
# your GitHub Pages URL in production, e.g.:
# ALLOWED_ORIGINS=https://rnii1.github.io
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# Port the server listens on. Most PaaS providers (Render, Railway, Fly)
# inject their own PORT env var automatically and this is ignored there.
PORT=8787
